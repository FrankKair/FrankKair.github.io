{{- $pages := where site.RegularPages "Section" "writing" -}}
{{- if and (not .IsHome) (ne .Section "posts") -}}{{- $pages = where .RegularPages "Section" "writing" -}}{{- end -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.Title }} · Writing</title>
    <link>{{ "writing/" | absURL }}</link>
    <description>{{ site.Params.description }}</description>
    <language>{{ site.Language.Locale }}</language>
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}
    {{ range first 20 $pages.ByDate.Reverse }}
    <item>
      <title>{{ .Title }}</title><link>{{ .Permalink }}</link><guid>{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <description>{{ .Description | default (.Summary | plainify) }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
